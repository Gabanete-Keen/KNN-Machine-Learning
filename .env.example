# Set these in the process environment; .env is not automatically loaded.
# Existing database path is the default. Use an absolute path to override it.
# DATABASE_PATH=C:/path/to/instance/pahuway.db
AUTH_SESSION_SECONDS=28800
# Local HTTP: 0. Set to 1 when serving through HTTPS in production.
SESSION_COOKIE_SECURE=0
# Set to the public URL when deploying behind a reverse proxy.
# APP_ORIGIN=https://example.com
